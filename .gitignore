node_modules
dist
.env
*.log

# Local data: the database holds API keys and WordPress Application Passwords,
# the rest is client screenshots, generated plugins and caches. Never commit it.
data/*
# The benchmark library is reusable research, safe to keep.
!data/benchmarks/

# Desktop build output
app-dist
release
release-owner
electron/build-info.json

# Figma API token (local only, never commit)
figma-token.txt
# Design library: version the extracted specs, keep the big reference images and scratch out.
design-library/**/*.png
design-library/**/*.jpg
design-library/**/*.jpeg
design-library/**/*.webp
# ...except the reference crops mockups are built from: they must ship with every copy of the repo.
!design-library/**/sections/*.jpg
!design-library/**/reference-*.jpg
design-library/**/_thumbs/**
design-library/**/_raw.json
design-library/_progress.log

# Cloud worker checkout of the jobs branch
.cloud-jobs/
out/
